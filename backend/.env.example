# Server Configuration
NODE_ENV=development
PORT=5000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_ai_internship
DB_USER=root
DB_PASSWORD=
# DB_SYNC: leave blank for safe sync, 'alter' to update columns, 'force' to drop & recreate
DB_SYNC=alter

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend URL
FRONTEND_URL=http://localhost:3000

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Email Configuration (Gmail Example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@smartai.com

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Secret
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# OTP Configuration
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payments (Module 12)
# PAYMENT_PROVIDER: 'sandbox' (simulated hosted checkout, Stripe test cards) or
# 'stripe' (real Stripe Checkout; used only when STRIPE_SECRET_KEY is also set).
PAYMENT_PROVIDER=sandbox
# Set to false in production so a missing Stripe key can never fall back to
# simulated payments.
PAYMENTS_SANDBOX_ENABLED=true
# Platform fee deducted from the student's payout, in percent (0-50).
PLATFORM_FEE_PERCENT=5
# Stripe keys from https://dashboard.stripe.com/test/apikeys (use sk_test_… keys
# in development). Never commit real keys.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint POST /api/payments/webhooks/stripe
# (whsec_…). Webhooks are rejected while this is empty.
STRIPE_WEBHOOK_SECRET=
